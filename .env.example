###############################################################################
# PostgreSQL connection settings
###############################################################################
POSTGRES_USER=root
POSTGRES_PASSWORD=root
POSTGRES_DB=delivery_service
POSTGRES_PORT=5432

###############################################################################
# Redis connection settings
###############################################################################
REDIS_PORT=6379

###############################################################################
# MailPit settings
###############################################################################
MAIL_PIT_SMTP_PORT=1025
MAIL_PIT_WEB_PORT=8025

###############################################################################
# RustFS settings
###############################################################################
RUSTFS_ACCESS_KEY=rustfsroot
RUSTFS_SECRET_KEY=rustfsrootsecret
RUSTFS_PORT=9000
RUSTFS_WEB_PORT=9001

###############################################################################
# ASP.NET solution appsettings.json secrets
###############################################################################
ASPNETCORE_ENVIRONMENT=Development

ConnectionStrings__PersistenceDbContext=User ID=<user>;Password=<password>;Host=<host>;Port=5432;Database=<database>;
ConnectionStrings__Redis=<host>:6379

JwtOptions__SecretKey=<strong-random-secret>
JwtOptions__ExpiresDays=30

SmtpOptions__Host=<host>
SmtpOptions__Port=1025
SmtpOptions__From=noreply@deliveryservice.com

AdministratorOptions__EmailAddress=<address>
AdministratorOptions__Password=<password>

StorageOptions__ServiceURL=http://localhost:9000
StorageOptions__AccessKey=rustfsroot
StorageOptions__SecretKey=rustfsrootsecret
StorageOptions__BucketName=delivery-service-bucket
